#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

# Power menu for Hyprland using Wofi
entries="💤 Suspender\n🚪 Encerrar Sessão\n🔄 Reiniciar\n⏻ Desligar"

selected=$(echo -e "$entries" | wofi --dmenu --prompt "Power Menu" --width 280 --height 220 --location center --hide-scroll)

case "$selected" in
    *"Suspender"*|*"Suspend"*)
        "$HOME/.local/bin/hypr-suspend"
        ;;
    *"Encerrar Sessão"*|*"Log Out"*|*"Sair"*)
        hyprctl dispatch "hl.dsp.exit()" >/dev/null 2>&1 || hyprctl dispatch "hl.dsp.exec_raw('exit')" >/dev/null 2>&1 || hyprctl dispatch exit
        ;;
    *"Reiniciar"*|*"Restart"*)
        systemctl reboot
        ;;
    *"Desligar"*|*"Shut Down"*)
        systemctl poweroff
        ;;
esac
