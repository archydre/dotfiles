#!/usr/bin/env bash

# hypr-workspace-scroll: Throttle workspace switching, prevent scroll leaks and provide linear GNOME-like navigation
ACTION="${1:-next}"
COOLDOWN_MS=160
STATE_FILE="/dev/shm/hypr_workspace_scroll.time"

NOW=$(date +%s%3N 2>/dev/null || echo 0)
LAST=0

if [ -f "$STATE_FILE" ]; then
    RAW_LAST=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
    LAST=$(echo "$RAW_LAST" | cut -d. -f1)
fi

DIFF=$(( NOW - LAST ))

switch_workspace() {
    local target="$1"
    hyprctl dispatch "hl.dsp.focus({ workspace = ${target} })" >/dev/null 2>&1 || \
    hyprctl dispatch "hl.dsp.exec_raw('workspace ${target}')" >/dev/null 2>&1 || \
    hyprctl dispatch workspace "${target}" >/dev/null 2>&1
}

move_to_workspace() {
    local target="$1"
    hyprctl dispatch "hl.dsp.window.move({ workspace = ${target} })" >/dev/null 2>&1 || \
    hyprctl dispatch "hl.dsp.exec_raw('movetoworkspace ${target}')" >/dev/null 2>&1 || \
    hyprctl dispatch movetoworkspace "${target}" >/dev/null 2>&1
}

if [ "$DIFF" -ge "$COOLDOWN_MS" ] || [ "$LAST" -eq 0 ]; then
    echo "$NOW" > "$STATE_FILE"

    ACTIVE_JSON=$(hyprctl activeworkspace -j 2>/dev/null)
    ACTIVE=$(echo "$ACTIVE_JSON" | jq -r '.id // 1' 2>/dev/null || echo 1)
    [ -z "$ACTIVE" ] || [ "$ACTIVE" = "null" ] && ACTIVE=1
    WINDOWS=$(echo "$ACTIVE_JSON" | jq -r '.windows // 0' 2>/dev/null || echo 0)

    case "$ACTION" in
        next)
            # Verifica a maior área de trabalho ocupada com janelas
            MAX_OCCUPIED=$(hyprctl clients -j 2>/dev/null | jq '[.[] | select(.workspace.id > 0) | .workspace.id] | max // 1' 2>/dev/null || echo 1)
            [ -z "$MAX_OCCUPIED" ] || [ "$MAX_OCCUPIED" = "null" ] && MAX_OCCUPIED=1

            # Se a área atual estiver vazia (0 janelas) e já for o fim da lista, impede avançar para mais vazios
            if [ "$WINDOWS" -eq 0 ] && [ "$ACTIVE" -ge "$MAX_OCCUPIED" ]; then
                exit 0
            fi
            if [ "$ACTIVE" -ge $(( MAX_OCCUPIED + 1 )) ]; then
                exit 0
            fi

            TARGET=$(( ACTIVE + 1 ))
            if [ "$TARGET" -gt 10 ]; then
                TARGET=10
            fi
            switch_workspace "$TARGET"
            ;;
        prev)
            # Recua linearmente sem passar do Workspace 1 (sem loop circular)
            if [ "$ACTIVE" -gt 1 ]; then
                TARGET=$(( ACTIVE - 1 ))
            else
                TARGET=1
            fi
            switch_workspace "$TARGET"
            ;;
        move_next)
            # Move janela para o próximo workspace (cria dinamicamente no final, estilo GNOME)
            TARGET=$(( ACTIVE + 1 ))
            if [ "$TARGET" -gt 10 ]; then
                TARGET=10
            fi
            move_to_workspace "$TARGET"
            ;;
        move_prev)
            # Move janela para o workspace anterior (mínimo 1)
            if [ "$ACTIVE" -gt 1 ]; then
                TARGET=$(( ACTIVE - 1 ))
            else
                TARGET=1
            fi
            move_to_workspace "$TARGET"
            ;;
    esac
fi
